# Copy to .env.local to try real staff accounts (Supabase Auth) instead of the local demo accounts.
# Requires staff/supabase/staff-schema.sql to be applied and a first super admin to exist (see staff/README.md).
VITE_STAFF_AUTH=supabase
# Optional overrides (defaults point at the 1Plan Supabase project). Only the PUBLISHABLE key belongs here, never service_role.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=
